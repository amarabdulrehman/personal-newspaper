# Copy to backend/.env and fill in. Never commit the real .env.

# Personalization
USER_NAME=Your Name

# Morning newspaper (24h clock, Asia/Karachi)
MORNING_HOUR=7
MORNING_MINUTE=0
CITY_NAME=Islamabad
WEATHER_LAT=33.6844
WEATHER_LON=73.0479

# WhatsApp Cloud API (Meta App Dashboard)
WHATSAPP_VERIFY_TOKEN=pick_any_random_string
WHATSAPP_ACCESS_TOKEN=          # permanent System User token (temporary tokens expire in 24h)
WHATSAPP_PHONE_NUMBER_ID=       # from WhatsApp > API Setup
WHATSAPP_APP_SECRET=            # App Settings > Basic > App Secret (verifies webhook signatures)
ALLOWED_PHONE_NUMBER=           # your number, country code, no + (e.g. 92300xxxxxxx)

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ESP32 auth — long random string, same value in firmware/esp32_printer.ino
PRINTER_API_KEY=

# Browser simulator at / and /api/demo/*. Unauthenticated: keep false when
# the server is reachable from the internet.
DEMO_ENABLED=false
